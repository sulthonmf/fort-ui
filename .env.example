# Public site URL used for Next.js metadataBase and Open Graph links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your Saweria donation URL (for example: https://saweria.co/username)
NEXT_PUBLIC_DONATE_URL=

# Comma-separated license tokens for authenticated Pro component downloads (/api/r/pro/[name])
FORT_UI_PRO_TOKENS=

