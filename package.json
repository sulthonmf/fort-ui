{
  "name": "fort-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run registry:build && next build",
    "cli:test": "node --test packages/cli/test/cli.test.mjs",
    "dev": "next dev",
    "fort-ui": "node ./packages/cli/bin/fort-ui.mjs",
    "registry:build": "node scripts/clean-registry.mjs && shadcn build && shadcn build registry.pro.json -o server/r/pro && shadcn build registry.native.json -o public/r/native",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
